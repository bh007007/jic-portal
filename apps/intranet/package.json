{
  "name": "@jic/intranet",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && npm run test && vite build",
    "build:portal": "tsc --noEmit && vite build --base /intranet/ --outDir ../admin/dist/intranet --emptyOutDir",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "esbuild server/core.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/core.test.mjs --log-level=warning && node node_modules/.cache/core.test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/node": "^20.16.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "esbuild": "^0.21.5",
    "typescript": "^5.5.4",
    "vite": "^5.4.6"
  }
}
