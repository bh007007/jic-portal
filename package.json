{
  "name": "jic-portal",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "admin": "npm --workspace apps/admin run dev",
    "admin:build": "npm --workspace apps/admin run build",
    "partner": "npm --workspace apps/partner run dev",
    "partner:build": "npm --workspace apps/partner run build",
    "student": "npm --workspace apps/student run dev",
    "student:build": "npm --workspace apps/student run build",
    "student:accounts": "npm --workspace apps/student run accounts --",
    "intranet": "npm --workspace apps/intranet run dev",
    "intranet:build": "npm --workspace apps/intranet run build",
    "typecheck": "npm --workspace apps/admin run typecheck && npm --workspace apps/partner run typecheck && npm --workspace apps/student run typecheck && npm --workspace apps/intranet run typecheck"
  }
}
